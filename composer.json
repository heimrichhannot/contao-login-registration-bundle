{
  "name": "heimrichhannot/contao-login-registration-bundle",
  "type": "contao-bundle",
  "description": "A frontend module that allows login and registration in one module.",
  "license": "GPL-3.0-or-later",
  "require": {
    "php": "^8.3",
    "contao/core-bundle": "^5.3",
    "symfony/event-dispatcher-contracts": "^3.0",
    "symfony/http-foundation": "^6.4 || ^7.0",
    "symfony/http-kernel": "^6.4 || ^7.0",
    "symfony/security-core": "^6.4 || ^7.0",
    "symfony/security-http": "^6.4 || ^7.0",
    "symfony/translation-contracts": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "HeimrichHannot\\LoginRegistrationBundle\\": "src/"
    }
  },
  "extra": {
    "contao-manager-plugin": "HeimrichHannot\\LoginRegistrationBundle\\ContaoManager\\Plugin"
  },
  "require-dev": {
    "rector/rector": "^2.6",
    "contao/contao-rector": "dev-main",
    "symplify/easy-coding-standard": "^12.6",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-symfony": "^2.0",
    "contao/manager-plugin": "^2.13"
  },
  "config": {
    "allow-plugins": {
      "contao-components/installer": false,
      "contao/manager-plugin": false,
      "php-http/discovery": false
    },
    "platform": {
      "php": "8.3.0"
    }
  },
  "scripts": {
    "rector": "rector process --dry-run",
    "phpstan": "phpstan analyse --no-progress",
    "ecs": "ecs check"
  }
}
